{
	"$schema": "https://docs.renovatebot.com/renovate-schema.json",
	"extends": [
		"config:recommended"
	],
	"ignorePaths": ["**/node_modules/**", "**/vendor/**"],
	"postUpdateOptions": ["gomodTidy"],
	"packageRules": [
		{
			"matchDatasources": ["crate"],
			"matchPackageNames": ["/^ruff_/"],
			"groupName": "ruff crates"
		},
		{
			"description": "Update the actionlint host and registry actions in one pull request.",
			"matchPackageNames": ["actionlint.kjanat.dev/v2", "kjanat/actionlint-registry"],
			"groupName": "actionlint integration"
		},
		{
			"description": "The wazero fork carries upstream tags with the upstream module path. The actionlint host requirement selects its version.",
			"matchPackageNames": ["github.com/kjanat/wazero"],
			"enabled": false
		}
	]
}
